<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.*?>

<HBox spacing="30" style="-fx-background-color: #F8FAFC; -fx-padding: 30;" stylesheets="@css/precifica_tela3.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.project30.precifica_tela3">

    <!-- Lado esquerdo: ScrollPane com formulário (ocupa todo o espaço restante) -->
    <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" HBox.hgrow="ALWAYS">
        <VBox spacing="25" styleClass="form-card">
            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <FontIcon iconColor="#081B5F" iconLiteral="bi-box" iconSize="22" />
                <Label styleClass="form-card-title" text="Produto Fabricado" />
            </HBox>

            <!-- DADOS DO PRODUTO -->
            <VBox spacing="20">
                <Label styleClass="section-title" text="Dados do Produto" />
                <GridPane hgap="20" vgap="18">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" />
                        <ColumnConstraints percentWidth="50" />
                    </columnConstraints>
                    <VBox spacing="6" GridPane.columnIndex="0">
                        <Label styleClass="input-label" text="Nome do Produto" />
                        <TextField fx:id="txtproduto" promptText="Ex: Pão artesanal" styleClass="custom-text-field" />
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="1">
                        <Label styleClass="input-label" text="Quantidade Produzida" />
                        <TextField fx:id="txtQuantidadeTotal" promptText="Ex: 1000" styleClass="custom-text-field" text="1" />
                    </VBox>
               <rowConstraints>
                  <RowConstraints />
               </rowConstraints>
                </GridPane>
            </VBox>

            <!-- INSUMOS DINÂMICOS -->
            <VBox spacing="12">
                <Label styleClass="section-title" text="Insumos" />
                <HBox alignment="CENTER_LEFT">
                    <FontIcon iconColor="#62B948" iconLiteral="bi-plus-circle" iconSize="16" />
                    <Button onAction="#adicionarInsumo" styleClass="add-cost-button" text="+ Adicionar Insumo" />
                </HBox>
                <VBox fx:id="insumosContainer" spacing="10" />
            </VBox>

            <!-- CUSTOS DE PRODUÇÃO DINÂMICOS -->
            <VBox spacing="12">
                <Label styleClass="section-title" text="Custos de Produção (Kz)" />
                <HBox alignment="CENTER_LEFT">
                    <FontIcon iconColor="#62B948" iconLiteral="bi-plus-circle" iconSize="16" />
                    <Button onAction="#adicionarCustoProducao" styleClass="add-cost-button" text="+ Adicionar Custo" />
                </HBox>
                <VBox fx:id="custosContainer" spacing="10" />
            </VBox>

            <!-- LUCRO -->
            <VBox spacing="10">
                <HBox alignment="CENTER_LEFT">
                    <Label styleClass="section-title" text="Lucro desejado (%)" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblLucroPercentual" styleClass="profit-percent" text="45%" />
                </HBox>
                <Slider fx:id="sliderLucro" max="100" min="0" value="45" />
            </VBox>

            <!-- BOTÃO ANTERIOR -->
            <HBox alignment="CENTER_RIGHT">
                <Button fx:id="btnAnterior" onAction="#aoClicarAnterior" styleClass="nav-button-secondary" text="Anterior">
                    <graphic>
                        <FontIcon iconColor="#475569" iconLiteral="bi-arrow-left" iconSize="14" />
                    </graphic>
                </Button>
            </HBox>

            <Region prefHeight="20" />
        </VBox>
    </ScrollPane>

    <!-- Lado direito: Card de resultado (fixo, sem scroll, com largura definida) -->
    <VBox prefWidth="280" spacing="25" styleClass="result-card" VBox.vgrow="NEVER">
        <Label styleClass="result-title" text="Resultado" />

        <VBox spacing="18">
            <VBox spacing="5">
                <Label styleClass="result-label" text="Preço mínimo" />
                <Label fx:id="lblPrecoMinimo" styleClass="result-value" text="0,00 Kz" />
            </VBox>
            <VBox spacing="5">
                <Label styleClass="result-label" text="Preço recomendado" />
                <Label fx:id="lblPrecoRecomendado" styleClass="result-value" text="0,00 Kz" />
            </VBox>
            <VBox spacing="5">
                <Label styleClass="result-label" text="Lucro por unidade" />
                <Label fx:id="lblLucroUnidade" styleClass="result-value" text="0,00 Kz" />
            </VBox>
            <VBox spacing="5">
                <Label styleClass="result-label" text="Margem de lucro" />
                <Label fx:id="lblMargemLucro" styleClass="result-value" text="45%" />
            </VBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS" />
        <Button fx:id="btnSeguinte" maxWidth="Infinity" onAction="#aoClicarSeguinte" styleClass="save-button" text="+ Salvar Produto" />
    </VBox>
</HBox>
