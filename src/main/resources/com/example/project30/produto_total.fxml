<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="25" style="-fx-background-color: #f8fafc;" stylesheets="@produto_total.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.project30.CadastrofuncioController" VBox.vgrow="ALWAYS">

    <VBox spacing="5" styleClass="header-banner">
        <padding>
            <Insets bottom="15" left="25" right="25" top="15" />
        </padding>
        <children>
            <HBox alignment="CENTER_LEFT" spacing="15">
                <children>
                    <StackPane styleClass="icon-kz-main">
                        <children>
                            <Label styleClass="icon-kz-text" text="Kz" />
                        </children>
                    </StackPane>
                    <VBox spacing="2">
                        <children>
                            <Label styleClass="header-title" text="Sistema de Precificação Baseado em Custos" />
                            <Label styleClass="header-subtitle" text="Cadastre seus produtos, defina preço dos itens e economize seu tempo." />
                        </children>
                    </VBox>
                </children>
            </HBox>
        </children>
    </VBox>

    <VBox spacing="20" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="0" left="25" right="25" top="0" />
        </padding>
        <children>

            <HBox alignment="CENTER_LEFT" spacing="15">
                <children>
                    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
                        <children>
                            <StackPane styleClass="card-badge, badge-blue">
                                <children>
                                    <Label styleClass="badge-text" text="Nº" />
                                </children>
                            </StackPane>
                            <VBox alignment="CENTER_LEFT">
                                <children>
                                    <Label styleClass="card-label" text="Total de Produtos" />
                                    <Label fx:id="totalProdutos" styleClass="card-number" text="0" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
                        <children>
                            <StackPane styleClass="card-badge, badge-green">
                                <children>
                                    <Label styleClass="badge-text" text="Kz" />
                                </children>
                            </StackPane>
                            <VBox alignment="CENTER_LEFT">
                                <children>
                                    <Label styleClass="card-label" text="Custo Total" />
                                    <Label fx:id="custoTotal" styleClass="card-number" text="0,00 Kz" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
                        <children>
                            <StackPane styleClass="card-badge, badge-blue">
                                <children>
                                    <Label styleClass="badge-text" text="Kz" />
                                </children>
                            </StackPane>
                            <VBox alignment="CENTER_LEFT">
                                <children>
                                    <Label styleClass="card-label" text="Venda Total" />
                                    <Label fx:id="vendaTotal" styleClass="card-number" text="0,00 Kz" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
                        <children>
                            <StackPane styleClass="card-badge, badge-green">
                                <children>
                                    <Label styleClass="badge-text" text="\%" />
                                </children>
                            </StackPane>
                            <VBox alignment="CENTER_LEFT">
                                <children>
                                    <Label styleClass="card-label" text="Lucro Total" />
                                    <Label fx:id="lucroTotal" styleClass="card-number" text="0,00 Kz" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>
                </children>
            </HBox>

            <VBox spacing="8" styleClass="search-container">
                <children>
                    <Label styleClass="section-title" text="Filtrar Catálogo" />
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <children>
                            <TextField fx:id="nomeProduto" promptText="Digite o nome do produto para pesquisar..." styleClass="form-input" HBox.hgrow="ALWAYS" />
                            <Button mnemonicParsing="false" prefHeight="38.0" prefWidth="140.0" styleClass="btn-search-css" text="Pesquisar" />
                        </children>
                    </HBox>
                </children>
            </VBox>

            <VBox style="-fx-padding: 0 0 25 0;" VBox.vgrow="ALWAYS">
                <children>
                    <TableView fx:id="tabelaProdutos" styleClass="custom-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn prefWidth="50.0" text="#" />
                            <TableColumn prefWidth="250.0" text="Nome do Produto" />
                            <TableColumn prefWidth="130.0" text="Custo (Kz)" />
                            <TableColumn prefWidth="130.0" text="Venda (Kz)" />
                            <TableColumn prefWidth="120.0" text="Margem (%)" />
                            <TableColumn prefWidth="140.0" text="Lucro Líquido (Kz)" />
                            <TableColumn prefWidth="120.0" text="Ações" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </children>
            </VBox>

        </children>
    </VBox>
</VBox>