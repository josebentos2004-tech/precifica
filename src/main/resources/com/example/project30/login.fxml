<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="500.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.project30.LoginController">

    <children>

        <!-- LADO ESQUERDO -->
        <AnchorPane layoutX="0.0" layoutY="0.0" prefHeight="500.0" prefWidth="600.0">
            <ImageView fitHeight="509.0" fitWidth="416.0" layoutX="-2.0" layoutY="1.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../../../fotos/login.png" />
                </image>
            </ImageView>

        </AnchorPane>


        <!-- LADO DIREITO -->
        <AnchorPane layoutX="350.0" layoutY="0.0" prefHeight="500.0" prefWidth="550.0" style="-fx-background-color: white;">

            <children>

                <Label layoutX="120.0" layoutY="80.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Bem-vindo(a)!" textFill="#081b5f" />

                <Label layoutX="120.0" layoutY="110.0" style="-fx-text-fill: gray;" text="Faça login para continuar" />

                <!-- USUÁRIO -->
                <Label layoutX="120.0" layoutY="160.0" text="Usuário" />

                <TextField fx:id="usuarioCampo" layoutX="120.0" layoutY="185.0" prefHeight="35.0" prefWidth="300.0" promptText="Digite seu usuário" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ccc;" />

                <!-- SENHA -->
                <Label layoutX="120.0" layoutY="240.0" text="Senha" />

                <PasswordField fx:id="senhaCampo" layoutX="120.0" layoutY="265.0" prefHeight="35.0" prefWidth="300.0" promptText="Digite sua senha" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ccc;" />

                <!-- BOTÃO -->
                <Button fx:id="btnEntrar" layoutX="120.0" layoutY="320.0" onAction="#btnEntrarAction" onMouseEntered="#hoverOn" onMouseExited="#hoverOff" prefHeight="40.0" prefWidth="300.0" style="-fx-background-color: #1C8D48; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 10; -fx-border-radius: 10;" text="Entrar" />

                <Hyperlink layoutX="120.0" layoutY="370.0" text="Ainda não tem  uma conta?" />

                <Button fx:id="btnCadastrar" layoutX="120.0" layoutY="410.0" onAction="#irParaCadastro" prefHeight="35.0" prefWidth="300.0" style="-fx-border-color: #1C8D48; -fx-text-fill: #1C8D48; -fx-background-radius: 10; -fx-border-radius: 10; -fx-background-color: white;" text="Cadastrar" />

            </children>

        </AnchorPane>

    </children>

</AnchorPane>
