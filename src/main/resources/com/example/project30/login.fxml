<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane prefHeight="600.0"
            prefWidth="1000.0"
            stylesheets="@css/login.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.project30.LoginController">

    <children>

        <HBox AnchorPane.topAnchor="0.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">

            <!-- PAINEL ESQUERDO -->
            <AnchorPane prefWidth="400.0"
                        styleClass="left-panel">

                <children>
                    <Pane styleClass="overlay"
                          AnchorPane.topAnchor="0.0"
                          AnchorPane.bottomAnchor="0.0"
                          AnchorPane.leftAnchor="0.0"
                          AnchorPane.rightAnchor="0.0"/>

                    <VBox alignment="CENTER"
                          spacing="15"
                          AnchorPane.topAnchor="0.0"
                          AnchorPane.bottomAnchor="0.0"
                          AnchorPane.leftAnchor="0.0"
                          AnchorPane.rightAnchor="0.0">

                        <ImageView fitHeight="450.0" fitWidth="450.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../../logo4.png"/>
                            </image>
                        </ImageView>




                    </VBox>
                </children>
            </AnchorPane>

            <!-- PAINEL DIREITO - CENTRALIZADO -->
            <AnchorPane HBox.hgrow="ALWAYS"
                        styleClass="right-panel">

                <children>
                    <!-- Container centralizado -->
                    <VBox spacing="20"
                          alignment="CENTER"
                          styleClass="form-container"
                          AnchorPane.leftAnchor="0"
                          AnchorPane.rightAnchor="0"
                          AnchorPane.topAnchor="0"
                          AnchorPane.bottomAnchor="0">

                        <!-- Card do formulário -->
                        <VBox spacing="20"
                              alignment="CENTER"
                              styleClass="login-card"
                              maxWidth="400"
                              prefWidth="380">

                            <!-- cabeçalho -->
                            <VBox spacing="5"
                                  alignment="CENTER">
                                <Label text="Bem-vindo(a)!"
                                       styleClass="title"/>
                                <Label text="Faça login para acessar sua conta"
                                       styleClass="subtitle"/>
                            </VBox>

                            <!-- campo usuário -->
                            <VBox spacing="8"
                                  alignment="CENTER_LEFT">
                                <Label text="Usuário"
                                       styleClass="input-label"/>

                                <HBox alignment="CENTER_LEFT"
                                      spacing="12"
                                      styleClass="input-container">
                                    <FontIcon iconLiteral="bi-person"
                                              styleClass="input-icon"/>
                                    <TextField fx:id="usuarioCampo"
                                               promptText="Digite seu Email"
                                               styleClass="text-field-custom"/>
                                </HBox>
                            </VBox>

                            <!-- campo senha -->
                            <VBox spacing="8"
                                  alignment="CENTER_LEFT">
                                <Label text="Senha"
                                       styleClass="input-label"/>

                                <HBox alignment="CENTER_LEFT"
                                      spacing="12"
                                      styleClass="input-container">
                                    <FontIcon iconLiteral="bi-lock"
                                              styleClass="input-icon"/>
                                    <PasswordField fx:id="senhaCampo"
                                                   promptText="Digite sua senha"
                                                   styleClass="text-field-custom"/>
                                </HBox>
                            </VBox>
                            <Hyperlink text="Não tem conta? Cadastrar"
                                       onAction="#irParaCadastro"
                                       styleClass="register-link"/>



                            <!-- botão login -->
                            <Button fx:id="btnEntrar"
                                    text="ENTRAR"
                                    onAction="#btnEntrarAction"
                                    styleClass="login-button"/>

                            <!-- link cadastro -->


                            <!-- mensagem de erro -->
                            <Label fx:id="mensagemErro"
                                   styleClass="error-message"
                                   visible="false"
                                   managed="false"/>
                        </VBox>
                    </VBox>
                </children>
            </AnchorPane>
        </HBox>
    </children>
</AnchorPane>