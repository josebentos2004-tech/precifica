<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.*?>

<VBox alignment="TOP_LEFT" spacing="25" style="-fx-padding: 35;" stylesheets="@precifica_tela5.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.project30.precifica_tela5">

    <Label styleClass="flow-title" text="Análise de Resultados" />

    <HBox alignment="TOP_CENTER" spacing="20" VBox.vgrow="ALWAYS">
        <children>

            <VBox maxWidth="350" spacing="20" styleClass="result-card" HBox.hgrow="ALWAYS">
                <children>
                    <HBox alignment="CENTER">
                        <children>
                            <Label styleClass="badge-lucro" text="✓ Lucro Saudável" />
                        </children>
                    </HBox>
                    <Label styleClass="result-text" text="Preço ideal está competitivo e abaixo do mercado." wrapText="true" />
                </children>
            </VBox>

            <VBox maxWidth="350" spacing="20" styleClass="result-card" HBox.hgrow="ALWAYS">
                <children>
                    <HBox alignment="CENTER">
                        <children>
                            <Label styleClass="badge-custo" text="⚠ Custo Elevado" />
                        </children>
                    </HBox>
                    <Label styleClass="result-text" text="Cuidado! Seu custo está alto para o mercado atual." wrapText="true" />
                </children>
            </VBox>

            <VBox maxWidth="450" alignment="CENTER" spacing="15" styleClass="result-card" HBox.hgrow="ALWAYS">
                <children>
                    <PieChart fx:id="graficoCustos" legendSide="BOTTOM" title="Divisão de Custos" prefHeight="300.0" prefWidth="350.0" />
                </children>
            </VBox>

        </children>
    </HBox>
</VBox>